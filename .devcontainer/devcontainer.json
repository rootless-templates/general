// -*- jsonc -*-
// For format details, see https://containers.dev/implementors/json_reference/.
{
  "name": "devcontainer-template-general",
  "build": {
    "dockerfile": "Containerfile"
  },
  // Log as rootless user
  "remoteUser": "worker",
  "containerUser": "worker",
  // Ensure git-untracked secrets files exist before the container is created,
  // since --env-file below is resolved at container creation time
  "initializeCommand": "bash .devcontainer/bootstrap-env.sh",
  // Define container name and host name, and load runtime secrets
  "runArgs": [
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/env.local",
    "--name",
    "devcontainer-${localWorkspaceFolderBasename}",
    "--hostname",
    "template-general"
  ],
  // Setup the repository on first connection
  "postCreateCommand": "just setup",
  // Set security for SE Linux
  "securityOpt": [ "label=disable" ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": []
    }
  }
}
